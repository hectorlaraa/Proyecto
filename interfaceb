# ─── Global state ─────────────────────────────────────────────────────────────
airports   = []
aircrafts  = []
departures = []
LEBL       = []
bcn        = None
APP_PASSWORD = "1234"   # Changeable at runtime

# ─── Input widgets (assigned inside show_app) ─────────────────────────────────
pathEntry          = None
ICAOEntry          = None
