# =============================================================================
# SPLASH / INTRO ANIMATION shown before the main window
# =============================================================================

def run_splash(on_done):
    """
    Full-screen pink splash with a large plane emoji that flies across,
    followed by a runway-style loading bar and a welcome text reveal.
    When the animation finishes, calls on_done() to show the main window.
    """
    splash = Tk()
    splash.title("")
    splash.configure(bg=BG_DARK)
    splash.state("zoomed")
    splash.overrideredirect(True)   # frameless

    sw = splash.winfo_screenwidth()
    sh = splash.winfo_screenheight()

    # ── Background canvas ──────────────────────────────────────────────────────
    c = Canvas(splash, bg=BG_DARK, highlightthickness=0)
    c.pack(fill="both", expand=True)

    # Runway dashes (decorative horizontal lines)
    for y_frac in [0.62, 0.64, 0.66]:
        y = int(sh * y_frac)
        for x in range(0, sw, 60):
            c.create_rectangle(x, y, x + 30, y + 2, fill=ACCENT_DIM, outline="")

    # Welcome text (starts invisible, fades in via color cycling)
    welcome = c.create_text(sw // 2, int(sh * 0.35),
                            text="AIRPORT MANAGER",
                            font=("Helvetica", 46, "bold"),
                            fill=BG_DARK)   # invisible at start

    subtitle = c.create_text(sw // 2, int(sh * 0.35) + 56,
                              text="Airport Management System",
                              font=("Helvetica", 16),
                              fill=BG_DARK)

    # Plane starts off the left edge
    plane_x = -80
    plane_y  = int(sh * 0.58)
    plane    = c.create_text(plane_x, plane_y,
                             text="✈",
                             font=("Helvetica", 64),
                             fill=ACCENT)

    # Loading bar background
    bar_x1, bar_y1 = sw // 2 - 220, int(sh * 0.75)
    bar_x2, bar_y2 = sw // 2 + 220, int(sh * 0.75) + 10
    c.create_rectangle(bar_x1, bar_y1, bar_x2, bar_y2,
                       fill=ACCENT_DIM, outline="")
    bar_fill = c.create_rectangle(bar_x1, bar_y1, bar_x1, bar_y2,
                                  fill=ACCENT, outline="")

    pct_text = c.create_text(sw // 2, bar_y2 + 20,
                             text="0%",
                             font=("Helvetica", 11, "bold"),
                             fill=TEXT_DIM)

    total_frames  = 80       # ~2 s at 25 ms per frame
    landing_frame = 55       # frame where plane reaches center and "lands"

    # Lerp helper
    def lerp_color(c1, c2, t):
        """Interpolate between two hex colors."""
        r1, g1, b1 = int(c1[1:3], 16), int(c1[3:5], 16), int(c1[5:7], 16)
        r2, g2, b2 = int(c2[1:3], 16), int(c2[3:5], 16), int(c2[5:7], 16)
        r = int(r1 + (r2 - r1) * t)
        g = int(g1 + (g2 - g1) * t)
        b = int(b1 + (b2 - b1) * t)
        return f"#{r:02x}{g:02x}{b:02x}"

    frame = [0]

    def tick():
        f = frame[0]

        # ── Plane movement ──────────────────────────────────────────────────
        if f <= landing_frame:
            # Fly from left to center, slight arc (parabola dip then rise)
            t   = f / landing_frame
            px  = int(-80 + (sw // 2 + 80) * t)
            # Gentle sine arc: dips slightly then levels out
            arc = int(30 * (1 - t) * t * 4)
            c.coords(plane, px, plane_y - arc)
        else:
            # After landing: slide right and off screen
            extra = f - landing_frame
            t2    = extra / (total_frames - landing_frame)
            px    = int(sw // 2 + (sw + 100) * t2)
            c.coords(plane, px, plane_y)

        # ── Loading bar ─────────────────────────────────────────────────────
        progress = min(f / total_frames, 1.0)
        fill_x   = bar_x1 + int((bar_x2 - bar_x1) * progress)
        c.coords(bar_fill, bar_x1, bar_y1, fill_x, bar_y2)
        c.itemconfig(pct_text, text=f"{int(progress * 100)}%")

        # ── Text reveal (fade in from frame 20 onward) ──────────────────────
        if f >= 20:
            t_text = min((f - 20) / 30, 1.0)
            col_w  = lerp_color(BG_DARK, TEXT_LIGHT, t_text)
            col_s  = lerp_color(BG_DARK, TEXT_DIM,   t_text)
            c.itemconfig(welcome,  fill=col_w)
            c.itemconfig(subtitle, fill=col_s)

        frame[0] += 1

        if f < total_frames:
            splash.after(25, tick)
        else:
            # Short pause then hand off
            splash.after(200, lambda: (splash.destroy(), on_done()))

    splash.after(50, tick)
    splash.mainloop()


